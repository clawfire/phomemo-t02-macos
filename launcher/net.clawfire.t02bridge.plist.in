<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.clawfire.t02bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@APP@/Contents/MacOS/T02Bridge</string>
        <string>@HOME_DIR@/venv/bin/python3</string>
        <string>-m</string>
        <string>t02bridge</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>@HOME_DIR@/app</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <string>net.clawfire.t02bridge</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/bridge.log</string>
</dict>
</plist>
